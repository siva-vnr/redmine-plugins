<h2>Tactical Meetings</h2>

<% if User.current.admin? %>
  <div class="contextual">
    <%= link_to "New Tactical Meeting", new_tactical_meeting_path, class: 'icon icon-add' %>
  </div>
<% end %>

<table class="list">
  <thead>
    <tr>
      <th>Start Date</th>
      <th>End Date</th>
      <th>Facilitator</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @tactical_meetings.each do |meeting| %>
      <tr>
        <td><%= meeting.start_date %></td>
        <td><%= meeting.end_date %></td>
        <td><%= meeting.facilitator %></td>
        <td>
          <%= link_to "Respond", new_tactical_meeting_response_path(tactical_meeting_id: meeting.id), class: 'icon icon-edit' %>
          <%= link_to "View Responses", tactical_meeting_responses_path(tactical_meeting_id: meeting.id), class: 'icon icon-view' %>
          <% if meeting.summary.present? %>
            <%= link_to "Summary", summary_tactical_meeting_path(meeting), class: 'icon icon-file' %>
          <% elsif Rails.cache.exist?(GenerateTacticalMeetingSummaryJob.generating_key(meeting.id)) %>
            <span>&#9203; Generating summary...</span>
          <% elsif User.current.admin? %>
            <%= link_to "✨ Generate Summary", generate_summary_tactical_meeting_path(meeting), method: :post %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
